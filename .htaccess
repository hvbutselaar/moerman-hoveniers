# Moerman Hoveniers — Hostinger (Apache/LiteSpeed)
RewriteEngine On

# www -> non-www (single hop naar https + apex)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# HTTP -> HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- 301-redirects van de oude WordPress-structuur (behoud ranking/verkeer) ---
# Hoofdpagina's oud -> nieuw
RewriteRule ^tuinontwerp/?$ /ontwerp.html [L,R=301]
RewriteRule ^aanleg/?$ /aanleg.html [L,R=301]
RewriteRule ^tuinonderhoud/?$ /onderhoud.html [L,R=301]
RewriteRule ^ons-werk/?$ /werk.html [L,R=301]
RewriteRule ^recensies/?$ /over-ons.html [L,R=301]
RewriteRule ^tuinkeur/?$ /over-ons.html [L,R=301]
RewriteRule ^contact/afspraak-maken/?$ /contact.html [L,R=301]
RewriteRule ^contact/?$ /contact.html [L,R=301]
RewriteRule ^privacyverklaring/?$ /privacy.html [L,R=301]
RewriteRule ^algemene-voorwaarden/?$ /voorwaarden.html [L,R=301]
RewriteRule ^vijvers/?$ /werk-vijver-amerongen.html [L,R=301]
RewriteRule ^houtbouw/?$ /werk-veranda-velp.html [L,R=301]

# Hernoemde projectpagina's (locatie gecorrigeerd, nov 2026)
RewriteRule ^werk-tuin-kootwijk\.html$ /werk-tuin-voorthuizen.html [L,R=301]
RewriteRule ^werk-veranda-barneveld\.html$ /werk-poolberging-arnhem.html [L,R=301]
RewriteRule ^werk-zembad\.html$ /werk-poolberging-arnhem.html [L,R=301]
RewriteRule ^werk-tuin-veenendaal\.html$ /werk-tuin-ede.html [L,R=301]
RewriteRule ^werk-tuin-uddel\.html$ /werk-tuin-arnhem.html [L,R=301]
RewriteRule ^werk-veranda-uddel\.html$ /werk-veranda-velp.html [L,R=301]

# Oude projectposts met een nieuwe tegenhanger
RewriteRule ^\d{4}/\d{2}/\d{2}/project-particuliere-tuin-veenendaal/?$ /werk-project-veenendaal.html [L,R=301]
RewriteRule ^\d{4}/\d{2}/\d{2}/vijver-amerongen/?$ /werk-vijver-amerongen.html [L,R=301]
# Geschrapte projecten (velp/elst) -> projectoverzicht
RewriteRule ^\d{4}/\d{2}/\d{2}/project-.*$ /werk.html [L,R=301]

# Alle overige blogposts (tuintips 2017-2023, datum-URL's) -> homepage
RewriteRule ^\d{4}/\d{2}/\d{2}/.*$ / [L,R=301]
# Blogoverzicht/categorie/auteur-archieven -> homepage
RewriteRule ^actueel(/.*)?$ / [L,R=301]
RewriteRule ^(category|author|tag)/.*$ / [L,R=301]

# Nette 404-pagina in de huisstijl
ErrorDocument 404 /404.html

# Expliciete charset in de Content-Type header (voorkomt Latin-1 misinterpretatie door crawlers)
AddDefaultCharset UTF-8

# ---------------------------------------------------------------- SECURITY HEADERS
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---------------------------------------------------------------- COMPRESSION
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------- CACHING
# Afbeeldingen wijzigen zelden in place -> lang cachen.
# CSS/JS worden in place bewerkt zonder cache-busting -> kort houden zodat updates doorkomen.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
